# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon / PostgreSQL Database URLs (Prisma 6.x)
# DATABASE_URL is typically the connection pooler URL (e.g. PgBouncer on Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL is the direct unpooled database connection used for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="supersecretdevjwtkey_change_in_production_12345"
