{
  "name": "realtime-chat-app",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time web chat application monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:server": "npm run build --workspace=backend",
    "build:client": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start:server": "npm run start --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:deploy": "npm run prisma:deploy --workspace=backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
